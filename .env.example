# Required — free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Server
PORT=3000

# Where torrents are saved (tilde + relative paths are expanded).
# WARNING under systemd: `EnvironmentFile=` does NOT expand `~` (the shell
# would; systemd won't). Use an absolute path here, and make sure the unit's
# `ReadWritePaths=` matches the *expanded* path exactly — otherwise writes
# silently fail against `ProtectHome=read-only`, torrents die on the first
# piece flush, and `/stream` hangs to a 30s timeout.
DOWNLOAD_PATH=~/Downloads/LlamaSpitStream

# Where scan/watch history is stored. Defaults to ~/.castcrate on the host
# user's home. Under a sandboxed systemd unit, either point this at a path
# your unit's `ReadWritePaths=` allows, or use `StateDirectory=castcrate`
# (which creates + hands you /var/lib/castcrate for free) and set
# HISTORY_DIR=/var/lib/castcrate.
# HISTORY_DIR=

# Pre-cast buffer threshold (% of file downloaded before "Cast" enables)
BUFFER_PERCENT=2

# --- Transcoding (smooth playback) ---
# Pre-cast buffer threshold when the transcode pipeline is active
TRANSCODE_BUFFER_PERCENT=5
# Target bitrate for the H.264 transcode (used as -b:v / -maxrate)
TRANSCODE_BITRATE=5M
# Override if ffmpeg isn't on PATH or you want a specific binary
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# --- Indexers ---
# YTS rotates domains when seized. Override if the default stops responding
# (yts.bz, yts.gg also work as of 2026-05).
# YTS_BASE_URL=https://movies-api.accel.li/api/v2

# Knaben aggregator (fallback when YTS / EZTV are empty).
# Default points at api.knaben.org.
# KNABEN_BASE_URL=https://api.knaben.org

# --- Proxy (optional) ---
# Route indexer searches through a SOCKS5 or HTTP proxy to bypass geo-blocks.
# Per-provider toggles are managed via Settings UI or PATCH /api/settings.
# Supported schemes: socks5h:// (remote DNS, recommended), socks5://, http://, https://
# Use socks5h:// to prevent your ISP's DNS from seeing blocked hostnames.
# Example (Mullvad SOCKS5): PROXY_URL=socks5h://user:password@socks5.mullvad.net:1080
# This value sets the default; the UI can override it at runtime.
# PROXY_URL=

# --- DNS bypass ---
# When the network blocks indexer hostnames at the resolver level,
# resolve via these upstreams before falling back to the OS resolver.
# Only applies to hostnames matching DNS_BYPASS_HOSTS — everything else
# (mDNS, OMDb, etc.) goes through the OS resolver as normal.
# Set DNS_BYPASS=false to disable entirely. Use DNS_BYPASS_HOSTS=* to
# revert to the legacy global behaviour.
# DNS_BYPASS=true
# DNS_UPSTREAMS=1.1.1.1,1.0.0.1
# DNS_BYPASS_HOSTS=yts,eztv,knaben

# --- OpenSubtitles (fallback subtitle source) ---
# OpenSubtitles integration — get a free API key at https://www.opensubtitles.com/en/consumers
# If left blank, OpenSubtitles fallback is disabled; only torrent-embedded subs are shown.
# Free tier: 5 downloads/day per key. Downloaded SRTs are cached to disk under
# <DOWNLOAD_PATH>/.opensubtitles/ so repeat plays never re-hit the quota.
OPENSUBTITLES_API_KEY=
# Comma-separated ISO 639 codes; results are filtered to these languages.
OPENSUBTITLES_LANGUAGES=en

# --- LAN IP override ---
# Override the LAN IP that Chromecast stream URLs are constructed from. Required
# for netns'd deploys (vpn-split-tunnel) where auto-detect only sees the veth
# (10.200.200.2) and would give the receiver an unreachable URL. Leave unset on
# macOS dev — auto-detect via os.networkInterfaces() works there.
# CASTCRATE_LAN_IP=192.168.x.y

# --- VPN routing (Linux deploy only) ---
# Three-way switch. Must match one of the literal values below exactly (no
# aliases, no case-insensitive match). Anything else collapses to "off".
#
#   off             — default; macOS dev, or Linux without VPN. Fastify on
#                     host. No netns configured. Pick this if you only stream
#                     from public sources (YTS, Knaben) and don't care about
#                     hiding your torrent-tracker IP.
#
#   vpn             — full-tunnel (v1, vpn-split-tunnel). Fastify runs INSIDE
#                     castcrate-ns; ALL outbound (indexers, peers, DHT,
#                     metadata, subtitles) exits via WireGuard. Pick this if
#                     you want maximum privacy for every outbound request.
#                     Trade-off: ~250ms RTT added to peer connections and
#                     reduced torrent throughput (typically <5 MB/s).
#
#   torrentday-only — split (v2, vpn-torrentday-only). Fastify runs on the
#                     host at full clearnet throughput; ONLY the TorrentDay
#                     adapter's HTTP fetches are routed through WG via
#                     `ip netns exec castcrate-ns node td-fetcher.js <url>`.
#                     Pick this if you use TorrentDay and want full peer
#                     throughput. Trade-off: loses the "all outbound is VPN'd"
#                     privacy property — trackers, metadata, subtitles etc.
#                     use your home IP.
VPN_MODE=off
# Home clearnet IP captured BEFORE enabling the netns. Used by
# /api/system/vpn-health to detect leaks (publicIp === HOST_CLEARNET_IP →
# leaking:true). Set per deploy runbook Phase 8. Leave blank on macOS dev
# or when leak detection is not required — leak checks default to false
# rather than false-positive when this is unset.
HOST_CLEARNET_IP=

# --- Watch Later queue ------------------------------------------------------
# Max concurrent background downloads spawned by the Watch Later queue. Kept
# low by default (2) because the 2011 MBP deploy box has 8 GB RAM and shares
# WebTorrent capacity with any active cast-now stream. Increase if the box
# has spare CPU + RAM + bandwidth.
MAX_CONCURRENT_QUEUED=2
