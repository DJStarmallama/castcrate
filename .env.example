# Required — free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Server
PORT=3000

# Where torrents are saved (tilde + relative paths are expanded).
# WARNING under systemd: `EnvironmentFile=` does NOT expand `~` (the shell
# would; systemd won't). Use an absolute path here, and make sure the unit's
# `ReadWritePaths=` matches the *expanded* path exactly — otherwise writes
# silently fail against `ProtectHome=read-only`, torrents die on the first
# piece flush, and `/stream` hangs to a 30s timeout.
DOWNLOAD_PATH=~/Downloads/LlamaSpitStream

# Where scan/watch history is stored. Defaults to ~/.castcrate on the host
# user's home. Under a sandboxed systemd unit, either point this at a path
# your unit's `ReadWritePaths=` allows, or use `StateDirectory=castcrate`
# (which creates + hands you /var/lib/castcrate for free) and set
# HISTORY_DIR=/var/lib/castcrate.
# HISTORY_DIR=

# Pre-cast buffer threshold (% of file downloaded before "Cast" enables)
BUFFER_PERCENT=2

# --- Transcoding (smooth playback) ---
# Pre-cast buffer threshold when the transcode pipeline is active
TRANSCODE_BUFFER_PERCENT=5
# Target bitrate for the H.264 transcode (used as -b:v / -maxrate)
TRANSCODE_BITRATE=5M
# Override if ffmpeg isn't on PATH or you want a specific binary
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# --- Indexers ---
# YTS rotates domains when seized. Override if the default stops responding
# (yts.bz, yts.gg also work as of 2026-05).
# YTS_BASE_URL=https://movies-api.accel.li/api/v2

# Knaben aggregator (fallback when YTS / EZTV are empty).
# Default points at api.knaben.org.
# KNABEN_BASE_URL=https://api.knaben.org

# --- Proxy (optional) ---
# Route indexer searches through a SOCKS5 or HTTP proxy to bypass geo-blocks.
# Per-provider toggles are managed via Settings UI or PATCH /api/settings.
# Supported schemes: socks5h:// (remote DNS, recommended), socks5://, http://, https://
# Use socks5h:// to prevent your ISP's DNS from seeing blocked hostnames.
# Example (Mullvad SOCKS5): PROXY_URL=socks5h://user:password@socks5.mullvad.net:1080
# This value sets the default; the UI can override it at runtime.
# PROXY_URL=

# --- DNS bypass ---
# When the network blocks indexer hostnames at the resolver level,
# resolve via these upstreams before falling back to the OS resolver.
# Only applies to hostnames matching DNS_BYPASS_HOSTS — everything else
# (mDNS, OMDb, etc.) goes through the OS resolver as normal.
# Set DNS_BYPASS=false to disable entirely. Use DNS_BYPASS_HOSTS=* to
# revert to the legacy global behaviour.
# DNS_BYPASS=true
# DNS_UPSTREAMS=1.1.1.1,1.0.0.1
# DNS_BYPASS_HOSTS=yts,eztv,knaben
