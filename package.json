{
  "name": "castcrate",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @castcrate/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @castcrate/server dev",
    "dev:web": "pnpm --filter @castcrate/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.0.8"
}
